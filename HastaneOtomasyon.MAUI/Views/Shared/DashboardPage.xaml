<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HastaneOtomasyon.MAUI.Views.Shared.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard"
    BackgroundColor="#F4F7FA"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="280,*">

        <!-- SOL MENÜ -->
        <Grid
            Grid.Column="0"
            BackgroundColor="#0F3D5E"
            Padding="28,34"
            RowDefinitions="Auto,*,Auto">

            <!-- Logo -->
            <VerticalStackLayout Grid.Row="0" Spacing="14">

                <HorizontalStackLayout Spacing="12">
                    <Border
                        WidthRequest="52"
                        HeightRequest="52"
                        BackgroundColor="#10B981"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17" />
                        </Border.StrokeShape>

                        <Label
                            Text="H"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="Hastane"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Otomasyon"
                            FontSize="13"
                            TextColor="#7EC8E3" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <BoxView
                    HeightRequest="1"
                    BackgroundColor="#2A6F8F"
                    Margin="0,10,0,0" />

            </VerticalStackLayout>

            <!-- Menü -->
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="12"
                VerticalOptions="Center">

                <Border
                    BackgroundColor="#173F5F"
                    Stroke="#2A6F8F"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🏠" FontSize="18" VerticalOptions="Center" />
                        <Label
                            Text="Ana Panel"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Label
                    Text="Randevu, hasta, doktor ve profil işlemlerine hızlı erişim sağlayabilirsiniz."
                    FontSize="13"
                    LineHeight="1.4"
                    TextColor="#9BD4E8" />

            </VerticalStackLayout>

            <!-- Alt çıkış -->
            <Button
                Grid.Row="2"
                x:Name="LogoutButton"
                Text="Çıkış Yap"
                Clicked="OnLogoutClicked"
                BackgroundColor="#173F5F"
                BorderColor="#2A6F8F"
                BorderWidth="1"
                TextColor="White"
                CornerRadius="14"
                HeightRequest="46"
                FontAttributes="Bold" />

        </Grid>

        <!-- ANA İÇERİK -->
        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36" Spacing="26">

                <!-- Üst başlık -->
                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label
                            Text="Hoş Geldiniz"
                            FontSize="13"
                            FontAttributes="Bold"
                            CharacterSpacing="1.8"
                            TextColor="#10B981" />

                        <Label
                            Text="Hastane Otomasyon Paneli"
                            FontSize="34"
                            FontAttributes="Bold"
                            TextColor="#061624" />

                        <Label
                            Text="Rolünüze göre ilgili işlemlere buradan ulaşabilirsiniz."
                            FontSize="14"
                            TextColor="#627D98" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#D9E2EC"
                        StrokeThickness="1"
                        Padding="16"
                        VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <HorizontalStackLayout Spacing="10">
                            <Border
                                WidthRequest="38"
                                HeightRequest="38"
                                BackgroundColor="#E0F2FE"
                                StrokeThickness="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="13" />
                                </Border.StrokeShape>

                                <Label
                                    Text="👤"
                                    FontSize="17"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Spacing="1">
                                <Label
                                    Text="Aktif Kullanıcı"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#102A43" />

                                <Label
                                    Text="Rol bazlı erişim"
                                    FontSize="11"
                                    TextColor="#8899AA" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Özet Bilgi -->
                <Border
                    BackgroundColor="#0F3D5E"
                    StrokeThickness="0"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label
                                Text="Merkezi Yönetim Alanı"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="Randevuları görüntüleyebilir, hasta ve doktor kayıtlarına erişebilir, profil bilgilerinizi yönetebilirsiniz."
                                FontSize="14"
                                LineHeight="1.4"
                                TextColor="#9BD4E8" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="72"
                            HeightRequest="72"
                            BackgroundColor="#10B981"
                            StrokeThickness="0"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>

                            <Label
                                Text="✓"
                                FontSize="36"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Kartlar -->
                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="18"
                    RowSpacing="18">

                    <!-- Randevular -->
                    <Border
                        x:Name="RandevuCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#D9E2EC"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRandevularTapped" />
                        </Border.GestureRecognizers>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Border
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="#E0F2FE"
                                StrokeThickness="0"
                                HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>

                                <Label
                                    Text="📅"
                                    FontSize="23"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Row="1" Spacing="4">
                                <Label
                                    Text="Randevu Yönetimi"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#102A43" />

                                <Label
                                    Text="Randevu listeleme, detay görüntüleme ve randevu oluşturma işlemleri."
                                    FontSize="13"
                                    LineHeight="1.35"
                                    TextColor="#627D98" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="2"
                                Text="İşleme git ›"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#0F3D5E" />
                        </Grid>
                    </Border>

                    <!-- Hastalar -->
                    <Border
                        x:Name="HastaCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#D9E2EC"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHastalarTapped" />
                        </Border.GestureRecognizers>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Border
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="#ECFDF5"
                                StrokeThickness="0"
                                HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>

                                <Label
                                    Text="👥"
                                    FontSize="23"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Row="1" Spacing="4">
                                <Label
                                    Text="Hasta İşlemleri"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#102A43" />

                                <Label
                                    Text="Hasta listesi, hasta detayları ve hasta bilgileri ekranları."
                                    FontSize="13"
                                    LineHeight="1.35"
                                    TextColor="#627D98" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="2"
                                Text="İşleme git ›"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#0F3D5E" />
                        </Grid>
                    </Border>

                    <!-- Doktorlar -->
                    <Border
                        x:Name="DoktorCard"
                        Grid.Row="1"
                        Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#D9E2EC"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDoktorlarTapped" />
                        </Border.GestureRecognizers>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Border
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="#F0F9FF"
                                StrokeThickness="0"
                                HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>

                                <Label
                                    Text="🩺"
                                    FontSize="23"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Row="1" Spacing="4">
                                <Label
                                    Text="Doktor İşlemleri"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#102A43" />

                                <Label
                                    Text="Doktor listesi, poliklinik filtreleme ve klinik iş akışları."
                                    FontSize="13"
                                    LineHeight="1.35"
                                    TextColor="#627D98" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="2"
                                Text="İşleme git ›"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#0F3D5E" />
                        </Grid>
                    </Border>

                    <!-- Profil -->
                    <Border
                        x:Name="ProfilCard"
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#D9E2EC"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfilTapped" />
                        </Border.GestureRecognizers>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <Border
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="#F8FAFC"
                                StrokeThickness="0"
                                HorizontalOptions="Start">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="17" />
                                </Border.StrokeShape>

                                <Label
                                    Text="⚙️"
                                    FontSize="23"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Row="1" Spacing="4">
                                <Label
                                    Text="Profil ve Ayarlar"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#102A43" />

                                <Label
                                    Text="Kullanıcı bilgileri, profil detayları ve hesap ayarları."
                                    FontSize="13"
                                    LineHeight="1.35"
                                    TextColor="#627D98" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Row="2"
                                Text="İşleme git ›"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#0F3D5E" />
                        </Grid>
                    </Border>

                    <!-- Admin / Audit -->
                    <Border
                        x:Name="AdminCard"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        BackgroundColor="White"
                        Stroke="#D9E2EC"
                        StrokeThickness="1"
                        Padding="22">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuditLogTapped" />
                        </Border.GestureRecognizers>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
                            <Border
                                Grid.Column="0"
                                WidthRequest="58"
                                HeightRequest="58"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <Label
                                    Text="🛡"
                                    FontSize="25"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label
                                    Text="Denetim Kayıtları"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#102A43" />

                                <Label
                                    Text="Admin kullanıcıları için sistem işlem geçmişi ve audit log kayıtları."
                                    FontSize="13"
                                    TextColor="#627D98" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="Aç ›"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#0F3D5E"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>