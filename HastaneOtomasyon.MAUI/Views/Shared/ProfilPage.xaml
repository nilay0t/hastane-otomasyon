<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HastaneOtomasyon.MAUI.Views.Shared.ProfilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Profil"
    BackgroundColor="#F4F7FA"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#0F3D5E"
            Padding="28,24"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Grid.Column="0" Spacing="6">
                <Label
                    Text="KULLANICI PROFİLİ"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#10B981" />

                <Label
                    Text="Profil ve Ayarlar"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Kullanıcı bilgileri, rol ve hesap güvenliği ayarlarını görüntüleyin."
                    FontSize="14"
                    TextColor="#9BD4E8" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                x:Name="BackButton"
                Text="← Panele Dön"
                Clicked="OnBackClicked"
                BackgroundColor="#173F5F"
                BorderColor="#2A6F8F"
                BorderWidth="1"
                TextColor="White"
                CornerRadius="14"
                HeightRequest="44"
                Padding="16,0"
                FontAttributes="Bold"
                VerticalOptions="Center" />
        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28" Spacing="20">

                <!-- STATUS -->
                <Border
                    x:Name="StatusContainer"
                    BackgroundColor="#F0F9FF"
                    Stroke="#BAE6FD"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <HorizontalStackLayout Spacing="12">
                        <Label
                            Text="ℹ"
                            FontSize="16"
                            TextColor="#0F3D5E"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="StatusLabel"
                            Text="Profil verisi için backend kullanıcı/profil servisi bağlanmalıdır."
                            FontSize="13"
                            TextColor="#0F3D5E"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- PROFILE CARD -->
                <Border
                    BackgroundColor="White"
                    Stroke="#D9E2EC"
                    StrokeThickness="1"
                    Padding="24">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="22">

                        <!-- Üst Profil Alanı -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">

                            <Border
                                Grid.Column="0"
                                WidthRequest="72"
                                HeightRequest="72"
                                BackgroundColor="#E0F2FE"
                                StrokeThickness="0"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <Label
                                    Text="👤"
                                    FontSize="32"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label
                                    x:Name="AdSoyadLabel"
                                    Text="Kullanıcı bilgisi yüklenmedi"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="#102A43" />

                                <Label
                                    x:Name="RolLabel"
                                    Text="Rol bilgisi yok"
                                    FontSize="14"
                                    TextColor="#627D98" />
                            </VerticalStackLayout>

                            <Border
                                Grid.Column="2"
                                BackgroundColor="#ECFDF5"
                                Stroke="#BBF7D0"
                                StrokeThickness="1"
                                Padding="14,8"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label
                                    Text="Aktif Oturum"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="#047857" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                        <!-- Bilgi Alanları -->
                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="18"
                            RowSpacing="18">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="18">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="KULLANICI ADI"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.8"
                                        TextColor="#10B981" />

                                    <Label
                                        x:Name="KullaniciAdiLabel"
                                        Text="-"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#102A43" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="18">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="E-POSTA"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.8"
                                        TextColor="#10B981" />

                                    <Label
                                        x:Name="EmailLabel"
                                        Text="-"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#102A43" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="18">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="TELEFON"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.8"
                                        TextColor="#10B981" />

                                    <Label
                                        x:Name="TelefonLabel"
                                        Text="-"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#102A43" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="18">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="YETKİ / ERİŞİM"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.8"
                                        TextColor="#10B981" />

                                    <Label
                                        x:Name="YetkiLabel"
                                        Text="-"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="#102A43" />
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="18">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        Text="HESAP NOTU"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CharacterSpacing="1.8"
                                        TextColor="#10B981" />

                                    <Label
                                        x:Name="HesapNotuLabel"
                                        Text="Profil bilgileri backend kullanıcı/profil servisi bağlandığında burada gösterilecektir."
                                        FontSize="14"
                                        TextColor="#627D98"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Actions -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">

                            <Button
                                Grid.Column="0"
                                Text="Panele Dön"
                                Clicked="OnBackClicked"
                                BackgroundColor="#EFF6FF"
                                BorderColor="#BFDBFE"
                                BorderWidth="1"
                                TextColor="#0F3D5E"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontAttributes="Bold" />

                            <Button
                                Grid.Column="1"
                                Text="Şifre Değiştir"
                                Clicked="OnChangePasswordClicked"
                                BackgroundColor="#0F3D5E"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="48"
                                Padding="18,0"
                                FontAttributes="Bold" />

                            <Button
                                Grid.Column="2"
                                Text="Çıkış Yap"
                                Clicked="OnLogoutClicked"
                                BackgroundColor="#DC2626"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="48"
                                Padding="18,0"
                                FontAttributes="Bold" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>