<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="HastaneOtomasyon.MAUI.Views.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    Title="Kayıt Ol"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="1.08*,0.92*">

        <!-- SOL PANEL -->
        <Grid
            Grid.Column="0"
            BackgroundColor="#0F3D5E"
            IsVisible="{OnIdiom Phone=False, Desktop=True, Tablet=True}">

            <!-- Dekoratif arka plan -->
            <BoxView
                WidthRequest="380"
                HeightRequest="380"
                CornerRadius="190"
                BackgroundColor="#10B981"
                Opacity="0.13"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="120"
                TranslationY="-130" />

            <BoxView
                WidthRequest="270"
                HeightRequest="270"
                CornerRadius="135"
                BackgroundColor="White"
                Opacity="0.05"
                HorizontalOptions="Start"
                VerticalOptions="End"
                TranslationX="-90"
                TranslationY="100" />

            <Grid Padding="46,42" RowDefinitions="Auto,*">

                <!-- Logo -->
                <HorizontalStackLayout
                    Grid.Row="0"
                    Spacing="14"
                    VerticalOptions="Start">

                    <Border
                        WidthRequest="58"
                        HeightRequest="58"
                        BackgroundColor="#10B981"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>

                        <Label
                            Text="H"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label
                            Text="Hastane Otomasyon"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="RANDEVU VE YÖNETİM SİSTEMİ"
                            FontSize="10"
                            CharacterSpacing="2"
                            TextColor="#7EC8E3" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Sol içerik -->
                <VerticalStackLayout
                    Grid.Row="1"
                    VerticalOptions="Center"
                    Spacing="22">

                    <Border
                        BackgroundColor="#173F5F"
                        Stroke="#2A6F8F"
                        StrokeThickness="1"
                        Padding="14,8"
                        HorizontalOptions="Start">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <HorizontalStackLayout Spacing="8">
                            <BoxView
                                WidthRequest="7"
                                HeightRequest="7"
                                CornerRadius="4"
                                BackgroundColor="#10B981"
                                VerticalOptions="Center" />

                            <Label
                                Text="YENİ KULLANICI KAYDI"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="1.5"
                                TextColor="#10B981" />
                        </HorizontalStackLayout>
                    </Border>

                    <Label
                        Text="Kullanıcı&#10;hesabınızı güvenli&#10;şekilde oluşturun."
                        FontSize="39"
                        FontAttributes="Bold"
                        LineHeight="1.05"
                        TextColor="White" />

                    <Label
                        Text="Hasta, doktor veya yönetici rolüne göre sisteme erişim sağlayan kullanıcı kayıt ekranı."
                        FontSize="15"
                        LineHeight="1.45"
                        MaximumWidthRequest="470"
                        TextColor="#9BD4E8" />

                    <!-- Sade özellik listesi -->
                    <VerticalStackLayout
                        Spacing="16"
                        Margin="0,10,0,0"
                        MaximumWidthRequest="520">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                Text="●"
                                FontSize="16"
                                TextColor="#10B981"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    Text="Rol bazlı kullanıcı kaydı"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="Admin, doktor ve hasta rolleri için hesap oluşturma"
                                    FontSize="12"
                                    TextColor="#A9DDF0"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                Text="●"
                                FontSize="16"
                                TextColor="#10B981"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    Text="Form doğrulama"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="Eksik bilgi, şifre eşleşmesi ve onay kontrolü"
                                    FontSize="12"
                                    TextColor="#A9DDF0"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label
                                Grid.Column="0"
                                Text="●"
                                FontSize="16"
                                TextColor="#10B981"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    Text="Güvenli hesap oluşturma"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                                <Label
                                    Text="Kullanıcı adı, e-posta ve şifre bilgileriyle kayıt"
                                    FontSize="12"
                                    TextColor="#A9DDF0"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- SAĞ KAYIT PANELİ -->
        <Grid
            Grid.Column="1"
            BackgroundColor="White"
            Padding="46,24"
            RowDefinitions="Auto,*">

            <!-- Üst bar -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto">

                <HorizontalStackLayout
                    Grid.Column="0"
                    Spacing="10"
                    IsVisible="{OnIdiom Phone=True, Desktop=False, Tablet=False}">

                    <Border
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="#0F3D5E"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13" />
                        </Border.StrokeShape>

                        <Label
                            Text="H"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Text="Hastane Otomasyon"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#0F3D5E"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button
                    Grid.Column="1"
                    x:Name="BackToLoginButton"
                    Text="Girişe Dön ›"
                    Clicked="OnBackToLoginClicked"
                    BackgroundColor="Transparent"
                    TextColor="#94A3B8"
                    FontSize="13"
                    FontAttributes="Bold"
                    Padding="0" />
            </Grid>

            <!-- Form -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout
                    MaximumWidthRequest="430"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="0"
                    Padding="0,8">

                    <!-- Başlık -->
                    <VerticalStackLayout Spacing="5" Margin="0,0,0,16">
                        <Label
                            Text="YENİ HESAP"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="2"
                            TextColor="#10B981" />

                        <Label
                            Text="Kayıt Oluştur"
                            FontSize="31"
                            FontAttributes="Bold"
                            TextColor="#061624" />

                        <Label
                            Text="Hastane otomasyon sistemi için kullanıcı bilgilerini girin."
                            FontSize="13"
                            TextColor="#8899AA" />
                    </VerticalStackLayout>

                    <!-- Ad Soyad — Uranium UI Material TextField (floating label) -->
                    <material:TextField
                        x:Name="AdSoyadEntry"
                        Title="Ad Soyad"
                        AccentColor="#0F3D5E"
                        BorderColor="#E2E8F0"
                        TextColor="#0F172A"
                        Margin="0,0,0,10" />

                    <!-- Kullanıcı Adı -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,10">
                        <Label
                            Text="KULLANICI ADI"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.8"
                            TextColor="#374151" />

                        <Border
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="2"
                            Padding="14,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    Text="🪪"
                                    FontSize="16"
                                    TextColor="#94A3B8"
                                    VerticalOptions="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="KullaniciAdiEntry"
                                    Placeholder="Kullanıcı adı"
                                    TextColor="#0F172A"
                                    PlaceholderColor="#CBD5E1"
                                    BackgroundColor="Transparent"
                                    HeightRequest="44" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- E-posta -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,10">
                        <Label
                            Text="E-POSTA"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.8"
                            TextColor="#374151" />

                        <Border
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="2"
                            Padding="14,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    Text="✉"
                                    FontSize="16"
                                    TextColor="#94A3B8"
                                    VerticalOptions="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="EmailEntry"
                                    Placeholder="ornek@email.com"
                                    Keyboard="Email"
                                    TextColor="#0F172A"
                                    PlaceholderColor="#CBD5E1"
                                    BackgroundColor="Transparent"
                                    HeightRequest="44" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Rol -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,10">
                        <Label
                            Text="ROL"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.8"
                            TextColor="#374151" />

                        <Border
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="2"
                            Padding="14,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Picker
                                x:Name="RolPicker"
                                Title="Rol seçiniz"
                                SelectedIndexChanged="OnRolPickerSelectionChanged"
                                TextColor="#0F172A"
                                TitleColor="#94A3B8"
                                BackgroundColor="Transparent"
                                HeightRequest="44">
                                <Picker.Items>
                                    <x:String>Hasta</x:String>
                                    <x:String>Doktor</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Şifre -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,10">
                        <Label
                            Text="ŞİFRE"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.8"
                            TextColor="#374151" />

                        <Border
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="2"
                            Padding="14,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    Text="🔒"
                                    FontSize="16"
                                    TextColor="#94A3B8"
                                    VerticalOptions="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="SifreEntry"
                                    Placeholder="Şifre"
                                    IsPassword="True"
                                    TextColor="#0F172A"
                                    PlaceholderColor="#CBD5E1"
                                    BackgroundColor="Transparent"
                                    HeightRequest="44" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Şifre Tekrar -->
                    <VerticalStackLayout Spacing="6" Margin="0,0,0,12">
                        <Label
                            Text="ŞİFRE TEKRAR"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="1.8"
                            TextColor="#374151" />

                        <Border
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="2"
                            Padding="14,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label
                                    Grid.Column="0"
                                    Text="🔐"
                                    FontSize="16"
                                    TextColor="#94A3B8"
                                    VerticalOptions="Center" />

                                <Entry
                                    Grid.Column="1"
                                    x:Name="SifreTekrarEntry"
                                    Placeholder="Şifre tekrar"
                                    IsPassword="True"
                                    TextColor="#0F172A"
                                    PlaceholderColor="#CBD5E1"
                                    BackgroundColor="Transparent"
                                    HeightRequest="44" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Onay -->
                    <HorizontalStackLayout Spacing="8" Margin="0,0,0,14">
                        <CheckBox
                            x:Name="OnayCheckBox"
                            Color="#0F3D5E"
                            VerticalOptions="Center" />

                        <Label
                            Text="Bilgilerimin doğru olduğunu onaylıyorum."
                            FontSize="13"
                            TextColor="#6B7280"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Kayıt Butonu -->
                    <Button
                        x:Name="KayitButton"
                        Text="Kayıt Oluştur"
                        Clicked="OnRegisterClicked"
                        BackgroundColor="#0F3D5E"
                        TextColor="White"
                        CornerRadius="14"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        FontSize="14"
                        Margin="0,0,0,10" />

                    <!-- Girişe Dön -->
                    <Button
                        x:Name="LoginNavigationButton"
                        Text="Zaten hesabınız var mı? Giriş yapın"
                        Clicked="OnBackToLoginClicked"
                        BackgroundColor="Transparent"
                        TextColor="#10B981"
                        FontAttributes="Bold"
                        FontSize="13"
                        HeightRequest="38" />

                    <Label
                        Text="© 2026 Hastane Randevu ve Yönetim Otomasyonu"
                        FontSize="11"
                        TextColor="#CBD5E1"
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Center"
                        Margin="0,6,0,0" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>